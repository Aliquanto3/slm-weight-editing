{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enableAllProjectMcpServers": false,
  "claudeMdExcludes": [
    "**/slm-weight-editing*/CLAUDE.md",
    "**/slm-weight-editing*/AGENTS.md"
  ],
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "WebFetch",
      "WebSearch",
      "Agent",
      "Task",
      "Skill",
      "mcp__*",
      "Read(//**/heldout/**)",
      "Read(//**/slm-quality-bench/**)",
      "Read(//**/lm_understand-logs/**)",
      "Read(//**/*lm_understand*/**)",
      "Read(//**/*RikiyaT*/**)",
      "Read(//**/*rikiyat*/**)",
      "Read(//**/*RikiyaT*)",
      "Read(//**/_bmad-output/**)",
      "Read(//**/_bmad/**)",
      "Read(//**/docs/**)",
      "Read(//**/tests/**)",
      "Read(//**/.git/**)",
      "Read(//**/README.md)",
      "Read(//**/AGENTS.md)",
      "Read(//**/slm_weight_editing/__init__.py)",
      "Read(//**/slm_weight_editing/report_gguf.py)",
      "Read(~/.claude/**)",
      "Read(~/.cache/huggingface/**)",
      "Edit(//**/models/sessions/*/state.json)",
      "Edit(//**/models/sessions/*/journal.jsonl)",
      "Edit(//**/models/sessions/*/session.lock)",
      "Edit(//**/models/sessions/*/freeze/**)",
      "Edit(//**/models/sessions/registry.jsonl)",
      "Edit(//**/state.json)",
      "Edit(//**/journal.jsonl)",
      "Edit(//**/registry.jsonl)",
      "Edit(//**/session.lock)",
      "Edit(//**/src/**)",
      "Edit(//**/.venv/**)",
      "Edit(//**/.claude/**)",
      "Edit(//**/pyproject.toml)",
      "Edit(//**/uv.lock)",
      "Edit(//**/CLAUDE.md)",
      "Edit(//**/CONSIGNE.md)",
      "Bash(*ollama*)",
      "Bash(*heldout*)",
      "Bash(*slm-quality-bench*)",
      "Bash(*lm_understand*)",
      "Bash(*RikiyaT*)",
      "Bash(*rikiyat*)",
      "Bash(*_bmad*)",
      "Bash(*huggingface*)",
      "Bash(*session-open*)",
      "Bash(*session-freeze*)",
      "Bash(*apply-diff*)",
      "Bash(*state.json*)",
      "Bash(*registry.jsonl*)",
      "Bash(*session.lock*)",
      "Bash(*transformers*)",
      "Bash(*torch*)",
      "Bash(*llama*)",
      "Bash(*pytest*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(pip *)",
      "Bash(uv add *)",
      "Bash(uv pip *)",
      "Bash(uv sync *)",
      "Bash(*base64*)",
      "Bash(*eval *)",
      "PowerShell(*ollama*)",
      "PowerShell(*heldout*)",
      "PowerShell(*slm-quality-bench*)",
      "PowerShell(*lm_understand*)",
      "PowerShell(*RikiyaT*)",
      "PowerShell(*_bmad*)",
      "PowerShell(*huggingface*)",
      "PowerShell(*session-open*)",
      "PowerShell(*session-freeze*)",
      "PowerShell(*state.json*)",
      "PowerShell(*registry.jsonl*)",
      "PowerShell(*session.lock*)",
      "PowerShell(*transformers*)",
      "PowerShell(*torch*)",
      "PowerShell(*Invoke-WebRequest*)",
      "PowerShell(*Invoke-RestMethod*)",
      "PowerShell(*Invoke-Expression*)",
      "PowerShell(*EncodedCommand*)",
      "PowerShell(git *)"
    ]
  }
}
